{
  "name": "ripcord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "scrape": "bun run scripts/scrape.ts",
    "dev": "next dev",
    "dev:setup": "bun run scripts/dev-setup.ts",
    "lint": "biome check .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "voice-worker": "bun run src/server/voice-worker/index.ts",
    "cron:verifications": "bun run scripts/cron-verifications.ts",
    "prepare": "node -e \"const fs=require('node:fs');if(fs.existsSync('.git')&&fs.existsSync('node_modules/lefthook'))require('node:child_process').execSync('lefthook install',{stdio:'inherit'})\"",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/oauth-provider": "1.7.14",
    "@mcp-use/client": "2.4.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@mozilla/readability": "0.6.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "iovalkey": "0.4.0",
    "linkedom": "0.18.14",
    "lucide-react": "^1.62.0",
    "mcp-use": "2.12.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "openai": "7.45.1",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "stripe": "23.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "6.2.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^24.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.37.0",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.32",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "overrides": {
    "esbuild": "^0.28.2",
    "katex": "^0.19.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "knip": {
    "next": false,
    "entry": [
      "middleware.ts",
      "next.config.js",
      "drizzle.config.ts",
      "scripts/*.{ts,mjs}",
      "src/app/**/{page,layout,loading,error,not-found,route}.tsx",
      "src/app/**/route.ts",
      "src/app/{opengraph-image,apple-icon}.tsx",
      "src/server/voice-worker/index.ts",
      "src/shared/components/ui/*.tsx",
      "src/styles/globals.css"
    ],
    "project": [
      "src/**/*.{ts,tsx,js,jsx}",
      "scripts/*.{ts,mjs}",
      "*.{js,ts}"
    ],
    "drizzle": false,
    "ignore": [
      "src/server/db/schema.ts",
      "src/trpc/server.ts",
      "src/shared/components/theme-toggle.tsx"
    ],
    "ignoreDependencies": [
      "shadcn",
      "lucide-react",
      "markdownlint-cli2",
      "@ast-grep/cli",
      "fallow",
      "server-only"
    ],
    "rules": {
      "types": "off"
    },
    "ignoreBinaries": [
      "make"
    ]
  }
}

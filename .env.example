# Copy this file to ".env" and fill in your values. Do not commit ".env".
# When you add a variable, add it to the schema in src/shared/config/env.js too.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ripcord"

# Host port for the compose PostgreSQL service (default: 5432). Docker Compose reads it from .env.
# Change it when another project already uses 5432, and use the same port in DATABASE_URL.
POSTGRES_PORT=5432

# Better Auth secret (required in production). Generate one with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# Public base URL of this app. Must be the production URL in production.
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used for the MCP resource identifier (`APP_URL/api/mcp`).
APP_URL="http://localhost:3000"

# Twilio credentials for holder SMS (required in production; without them non-production logs SMS to the console)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# Valkey connection string for mandate tokens, OTP codes and rate limits
VALKEY_URL="redis://localhost:6379"

# SMTP server for login codes (Mailpit in development)
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="RipCord <noreply@ripcord.local>"

# Vault master key: base64 for 32 bytes (required in production). Generate one with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=""
VAULT_KEY_VERSION=1

# Bearer secret for the cron routes POST /api/cron/retention and /api/cron/audit-verify (required in production)
CRON_SECRET=""

# S3-compatible object storage for case documents (MinIO in development)
S3_ENDPOINT="http://localhost:9100"
S3_BUCKET="ripcord"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Comma-separated emails that always have provider-admin access (first admin bootstrap)
ADMIN_EMAILS=""

# Model adapter (spec 0004). Production sets MODEL_PROVIDER=meta with a key; development and CI stay on fake.
META_API_KEY=""
META_BASE_URL="https://api.meta.ai/v1"
MODEL_STANDARD="muse-spark-1.3"
MODEL_CONTRIBUTOR="muse-spark-1.3-contributor"
MODEL_PROVIDER="fake"
# Per-model prices in USD per million tokens: {"<model>":{"input":n,"output":n},"default":{...}}
MODEL_PRICES_JSON='{"default":{"input":1,"output":3}}'
# Monthly model budgets in micro-dollars (US$2 per individual, US$20 per org)
MODEL_BUDGET_USER_MICROS=2000000
MODEL_BUDGET_ORG_MICROS=20000000

# Execution channels (spec 0005). Live sending needs all three: LIVE_MODE_ENABLED=true,
# the case out of sandbox, and the mandate's live-mode approval. Otherwise email goes to
# the sandbox SMTP server (Mailpit) and phone calls use the simulated adapter.
LIVE_MODE_ENABLED="false"
SANDBOX_SMTP_URL="smtp://localhost:1025"
TELEPHONY_PROVIDER="simulated"
# Sender number for provider calls; needed only when TELEPHONY_PROVIDER is twilio.
TWILIO_VOICE_FROM=""
# Base URL of the voice worker (`bun run voice-worker`); Twilio media streams connect here.
VOICE_WORKER_URL="http://localhost:3101"

# MCP server (spec 0006). The dev bypass works only when NODE_ENV is
# development AND MCP_DEV_BYPASS is true; every other environment fails
# closed to OAuth. Allowed hosts/origins are comma-separated, unset by default.
MCP_DEV_BYPASS="false"
MCP_DEV_USER_EMAIL=""
MCP_ALLOWED_HOSTS=""
MCP_ALLOWED_ORIGINS=""

# Billing (spec 0007). Stripe test mode for the hackathon. Prices live in
# Stripe and in env; the app never hard-codes amounts except for display.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CREDIT=""
STRIPE_PRICE_CREDIT_ORG=""
STRIPE_PRICE_ORG_MONTHLY=""
PRICE_CREDIT_DISPLAY="S$1.99"

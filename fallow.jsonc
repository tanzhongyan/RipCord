{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": ["**/.next/**", "**/dist/**", "**/node_modules/**"],
  "duplicates": {
    "minTokens": 50,
    "minLines": 10,
    "minOccurrences": 2,
    "ignore": ["**/*.test.*", "**/*.spec.*"]
  },
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 12,
    "maxUnitSize": 60,
    "maxCrap": 30.0
  }
}
